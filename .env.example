# AQUA-NEXUS Configuration

# Application
APP_NAME=AQUA-NEXUS
ENVIRONMENT=development
DEBUG=True
LOG_LEVEL=INFO

# Backend Server
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173"]

# Database
# SQLite for initial prototype; easily replace with postgresql+asyncpg://...
DATABASE_URL=sqlite+aiosqlite:///./aqua_nexus.db
DATABASE_SYNC_URL=sqlite:///./aqua_nexus.db

# MQTT Broker
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883
MQTT_CLIENT_ID=aqua-nexus-backend
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_KEEPALIVE=60

# Water System Thresholds & Parameters
TANK_CAPACITY_LITERS=100.0
TANK_HIGH_THRESHOLD_PCT=90.0
TANK_LOW_THRESHOLD_PCT=20.0
TANK_CRITICAL_THRESHOLD_PCT=10.0

# Leakage Thresholds
UNACCOUNTED_WARNING_PCT=5.0
UNACCOUNTED_LEAK_PCT=10.0

# Quota Warning Threshold
ALLOCATION_WARNING_PCT=80.0

# Device Watchdog Timeout (seconds)
DEVICE_OFFLINE_TIMEOUT_SEC=10

# Automatic Control Rules Enforcement
AUTO_CUTOFF_VALVE_ON_ALLOCATION=True
AUTO_CUTOFF_PUMP_ON_OVERFLOW=True
AUTO_PROTECT_PUMP_ON_DRY_RUN=True
